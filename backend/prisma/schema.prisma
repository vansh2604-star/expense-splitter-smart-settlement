generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TransactionType {
  INITIAL_CREDIT
  CREDIT
  DEBIT
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  wallet Wallet?

  createdGroups Group[]       @relation("GroupCreator")
  groupMembers  GroupMember[]

  expensesPaid  Expense[]      @relation("UserExpensesPaid")
  expenseSplits ExpenseSplit[] @relation("UserExpenseSplits")

  sentSettlements     SettlementPayment[] @relation("SettlementFromUser")
  receivedSettlements SettlementPayment[] @relation("SettlementToUser")

  // Wallet transactions involving another user
  relatedWalletTransactions WalletTransaction[] @relation("RelatedWalletTransactions")
}

model Wallet {
  id        String   @id @default(cuid())
  balance   Decimal  @default(1000) @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  transactions WalletTransaction[]
}

model WalletTransaction {
  id        String          @id @default(cuid())
  amount    Decimal         @db.Decimal(12, 2)
  type      TransactionType
  reason    String
  createdAt DateTime        @default(now())

  walletId String
  wallet   Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  // Optional user involved in this transaction
  relatedUserId String?
  relatedUser   User?   @relation("RelatedWalletTransactions", fields: [relatedUserId], references: [id])

  @@index([walletId])
  @@index([relatedUserId])
}

model Group {
  id          String   @id @default(cuid())
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // User who created the group
  createdById String
  createdBy   User   @relation("GroupCreator", fields: [createdById], references: [id], onDelete: Cascade)

  // Members inside the group
  members     GroupMember[]
  expenses    Expense[]
  settlements SettlementPayment[]

  @@index([createdById])
}

model GroupMember {
  id       String   @id @default(cuid())
  joinedAt DateTime @default(now())

  userId  String
  groupId String

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // Prevent the same user from joining the same group twice
  @@unique([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model Expense {
  id          String  @id @default(cuid())
  description String
  amount      Decimal @db.Decimal(12, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  groupId  String
  paidById String

  group  Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  paidBy User  @relation("UserExpensesPaid", fields: [paidById], references: [id], onDelete: Cascade)

  splits ExpenseSplit[]

  @@index([groupId])
  @@index([paidById])
}

model ExpenseSplit {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  expenseId String
  userId    String

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation("UserExpenseSplits", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([expenseId, userId])
  @@index([userId])
}

model SettlementPayment {
  id        String   @id @default(cuid())
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  groupId    String
  fromUserId String
  toUserId   String

  group    Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  fromUser User  @relation("SettlementFromUser", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUser   User  @relation("SettlementToUser", fields: [toUserId], references: [id], onDelete: Cascade)

  @@index([groupId])
  @@index([fromUserId])
  @@index([toUserId])
}
